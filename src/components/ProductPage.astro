---
import Layout from "../layouts/Layout.astro";
import ProblemIllustration from "./ProblemIllustration.astro";
import { products } from "../lib/products";
import { SITE_URL, BOOKING_URL } from "../lib/site-pages";

interface Problem {
  num: string;
  title: string;
  description: string;
}

interface Feature {
  title: string;
  description: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  /** Must match a slug in src/lib/products.ts; supplies category, status, and the cross-links. */
  slug: string;
  headline: string;
  /** Sits between the headline and the subheadline. Usually the product tagline. */
  subtitle?: string;
  subheadline: string;
  seoTitle: string;
  seoDescription: string;
  /** Exactly three; the section is a three-up grid with one illustration each. */
  problems: Problem[];
  problemsHeadline: string;
  features: Feature[];
  featuresHeadline: string;
  /** Omit to drop the forest stats band, for products with no numbers to stand behind. */
  stats?: Stat[];
  ctaHeadline: string;
  ctaDescription: string;
  ctaLabel?: string;
}

const {
  slug,
  headline,
  subtitle,
  subheadline,
  seoTitle,
  seoDescription,
  problems,
  problemsHeadline,
  features,
  featuresHeadline,
  stats,
  ctaHeadline,
  ctaDescription,
  ctaLabel = "Get a demo",
} = Astro.props;

const product = products.find((p) => p.slug === slug);
if (!product) throw new Error(`ProductPage: no product registered with slug "${slug}"`);

const otherProducts = products.filter((p) => p.slug !== slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: new URL(Astro.url.pathname, SITE_URL).href,
  publisher: { "@type": "Organization", name: "Basiq", url: SITE_URL },
  mainEntity: {
    "@type": "SoftwareApplication",
    name: product.name,
    description: seoDescription,
    applicationCategory: "BusinessApplication",
    url: new URL(Astro.url.pathname, SITE_URL).href,
  },
};

const displayH2 =
  "font-display text-4xl font-normal leading-tight tracking-[-0.02em] text-heading md:text-5xl";
---

<Layout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <!-- HERO: narrative, so left-aligned -->
  <header class="pb-20 pt-20 lg:pt-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-12">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-block rounded-full bg-forest px-4 py-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
          {product.category}
        </span>
        <span
          class={
            product.status === "live"
              ? "rounded-full border border-line bg-stone px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-forest"
              : "rounded-full border border-control px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted"
          }
        >
          {product.status === "live" ? "Live" : "Coming soon"}
        </span>
      </div>

      <h1 class="mt-8 max-w-4xl font-display text-4xl font-normal leading-[1.08] tracking-[-0.025em] text-heading md:text-5xl lg:text-6xl">
        {headline}
      </h1>
      {subtitle && <p class="mt-5 max-w-2xl text-xl italic text-forest">{subtitle}</p>}
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-body md:text-xl">{subheadline}</p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a
          href={BOOKING_URL}
          class="rounded-full bg-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover"
        >
          {ctaLabel}
        </a>
        <a
          href="/products"
          class="rounded-full border border-forest bg-transparent px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest transition-all hover:bg-stone"
        >
          All products
        </a>
      </div>
    </div>
  </header>

  <!-- Optional slot for a video or screenshots under the hero. -->
  <slot name="after-hero" />

  <!-- PROBLEMS -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        <span class="mr-2">&#9679;</span>The problem
      </p>
      <h2 class={`mt-4 max-w-3xl ${displayH2}`}>{problemsHeadline}</h2>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {
          problems.map((problem, i) => (
            <div class="rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift">
              <div class="mb-6 flex h-40 items-center justify-center rounded-xl bg-stone">
                <ProblemIllustration index={i} />
              </div>
              <span class="font-display text-5xl leading-none text-sage">{problem.num}</span>
              <h3 class="mt-4 font-display text-xl text-heading">{problem.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-body">{problem.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        <span class="mr-2">&#9679;</span>What {product.name} does
      </p>
      <h2 class={`mt-4 max-w-3xl ${displayH2}`}>{featuresHeadline}</h2>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift">
              <h3 class="font-display text-xl text-heading">{feature.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-body">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    stats && stats.length > 0 && (
      <section class="on-forest bg-forest">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
          <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" id="stats-grid">
            {stats.map((stat, i) => (
              <div class="text-center" data-stat={stat.value} data-delay={i * 120}>
                <p class="stat-value font-display text-5xl leading-none text-gold md:text-6xl" aria-label={stat.value}>
                  {stat.value}
                </p>
                <p class="mt-4 text-sm leading-relaxed text-on-dark-muted">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Page-specific sections (comparison tables, business cases) go here. -->
  <slot />

  <!-- CTA -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class={displayH2}>{ctaHeadline}</h2>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-body">{ctaDescription}</p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href={BOOKING_URL}
            class="rounded-full bg-forest px-8 py-4 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover"
          >
            {ctaLabel}
          </a>
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          {
            otherProducts.map((p) => (
              <a
                href={p.href}
                target={p.external ? "_blank" : undefined}
                rel={p.external ? "noopener noreferrer" : undefined}
                class="rounded-full border border-control px-4 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-body transition-colors hover:bg-stone hover:text-forest"
              >
                {p.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    Stats settle from a digit scramble when the band scrolls into view. The final
    value is rendered server-side and carried on aria-label, so the numbers are
    correct without JS and are never read mid-scramble by a screen reader.
  -->
  <script>
    (function () {
      const grid = document.getElementById("stats-grid");
      if (!grid) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const chars = "0123456789";
      const duration = 1200;

      /** Split "$3.6M" into digit runs and literal runs, so only digits scramble. */
      function extractParts(value: string) {
        const parts: { type: "num" | "text"; value: string }[] = [];
        let current = "";
        let currentType: "num" | "text" | null = null;
        for (const ch of value) {
          const type = ch >= "0" && ch <= "9" ? "num" : "text";
          if (type !== currentType) {
            if (current) parts.push({ type: currentType!, value: current });
            current = ch;
            currentType = type;
          } else {
            current += ch;
          }
        }
        if (current) parts.push({ type: currentType!, value: current });
        return parts;
      }

      function scramble(el: HTMLElement, finalValue: string, delay: number) {
        const parts = extractParts(finalValue);
        setTimeout(() => {
          const start = performance.now();
          function frame() {
            const progress = Math.min((performance.now() - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            let display = "";
            for (const part of parts) {
              if (part.type === "text") {
                display += part.value;
                continue;
              }
              for (let d = 0; d < part.value.length; d++) {
                display +=
                  eased * part.value.length > d + 1
                    ? part.value[d]
                    : chars[Math.floor(Math.random() * chars.length)];
              }
            }
            el.textContent = display;
            if (progress < 1) requestAnimationFrame(frame);
            else el.textContent = finalValue;
          }
          requestAnimationFrame(frame);
        }, delay);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            grid.querySelectorAll("[data-stat]").forEach((el) => {
              const host = el as HTMLElement;
              const valueEl = host.querySelector(".stat-value") as HTMLElement | null;
              if (valueEl) scramble(valueEl, host.dataset.stat!, parseInt(host.dataset.delay || "0", 10));
            });
            observer.disconnect();
          });
        },
        { threshold: 0.3 }
      );
      observer.observe(grid);
    })();
  </script>
</Layout>

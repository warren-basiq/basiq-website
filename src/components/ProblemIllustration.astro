---
/**
 * The three abstract marks that head the problem cards on persona and product
 * pages. Index order is fixed and meaningful:
 *
 *   0  a chain that stops carrying, for work that stalls partway
 *   1  stacked layers with the top one unreadable, for what you cannot see
 *   2  many inputs converging on one hub, for scattered signal pulled together
 *
 * Decorative only, so each is aria-hidden and carries no title.
 */
interface Props {
  index: number;
}

const { index } = Astro.props;
---

{
  index === 0 && (
    <svg width="120" height="100" viewBox="0 0 120 100" fill="none" aria-hidden="true">
      <circle cx="20" cy="50" r="12" fill="none" stroke="#234136" stroke-width="1.5" opacity="0.35" />
      <circle cx="20" cy="50" r="5" fill="#234136" opacity="0.18" />
      <line x1="32" y1="50" x2="42" y2="50" stroke="#899083" stroke-width="1.5" />
      <circle cx="54" cy="50" r="12" fill="none" stroke="#234136" stroke-width="1.5" opacity="0.3" />
      <circle cx="54" cy="50" r="5" fill="#234136" opacity="0.15" />
      <line x1="66" y1="50" x2="72" y2="50" stroke="#899083" stroke-width="1.5" stroke-dasharray="3 3" />
      <line x1="80" y1="50" x2="86" y2="50" stroke="#899083" stroke-width="1.5" stroke-dasharray="3 3" />
      <circle cx="100" cy="50" r="12" fill="none" stroke="#234136" stroke-width="1" opacity="0.16" stroke-dasharray="4 3" />
      <circle cx="100" cy="50" r="5" fill="#234136" opacity="0.08" />
      <path d="M60 72 L60 92" stroke="#899083" stroke-width="1" />
      <path d="M56 88 L60 94 L64 88" stroke="#899083" stroke-width="1" fill="none" />
    </svg>
  )
}
{
  index === 1 && (
    <svg width="120" height="100" viewBox="0 0 120 100" fill="none" aria-hidden="true">
      <rect x="15" y="15" width="50" height="35" rx="4" fill="#234136" fill-opacity="0.05" stroke="#234136" stroke-width="1" stroke-opacity="0.18" />
      <rect x="25" y="25" width="50" height="35" rx="4" fill="#234136" fill-opacity="0.08" stroke="#234136" stroke-width="1" stroke-opacity="0.24" />
      <rect x="35" y="35" width="50" height="35" rx="4" fill="#234136" fill-opacity="0.1" stroke="#234136" stroke-width="1.5" stroke-opacity="0.32" />
      <circle cx="95" cy="30" r="14" fill="none" stroke="#899083" stroke-width="1" stroke-dasharray="4 3" />
      <text x="95" y="36" text-anchor="middle" fill="#899083" font-size="16" font-weight="bold">?</text>
      <circle cx="20" cy="82" r="3" fill="#234136" opacity="0.14" />
      <circle cx="45" cy="87" r="2" fill="#234136" opacity="0.1" />
      <circle cx="70" cy="80" r="3.5" fill="#234136" opacity="0.16" />
      <circle cx="95" cy="84" r="2.5" fill="#234136" opacity="0.12" />
    </svg>
  )
}
{
  index === 2 && (
    <svg width="120" height="100" viewBox="0 0 120 100" fill="none" aria-hidden="true">
      <line x1="10" y1="15" x2="60" y2="50" stroke="#899083" stroke-width="1" />
      <line x1="60" y1="10" x2="60" y2="50" stroke="#899083" stroke-width="1" />
      <line x1="110" y1="15" x2="60" y2="50" stroke="#899083" stroke-width="1" />
      <line x1="15" y1="50" x2="60" y2="50" stroke="#899083" stroke-width="1" stroke-dasharray="4 3" />
      <line x1="105" y1="50" x2="60" y2="50" stroke="#899083" stroke-width="1" stroke-dasharray="4 3" />
      <circle cx="60" cy="50" r="14" fill="#234136" fill-opacity="0.1" stroke="#234136" stroke-width="1.5" stroke-opacity="0.32" />
      <circle cx="60" cy="50" r="6" fill="#D4A83F" />
      <circle cx="10" cy="15" r="5" fill="#234136" fill-opacity="0.1" stroke="#234136" stroke-width="1" stroke-opacity="0.24" />
      <circle cx="60" cy="10" r="5" fill="#234136" fill-opacity="0.1" stroke="#234136" stroke-width="1" stroke-opacity="0.24" />
      <circle cx="110" cy="15" r="5" fill="#234136" fill-opacity="0.1" stroke="#234136" stroke-width="1" stroke-opacity="0.24" />
      <line x1="60" y1="64" x2="60" y2="88" stroke="#234136" stroke-width="1.5" stroke-opacity="0.32" />
      <path d="M55 83 L60 90 L65 83" stroke="#234136" stroke-width="1.5" fill="none" stroke-opacity="0.32" />
    </svg>
  )
}

---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "../../lib/sanity";
import { SITE_URL } from "../../lib/site-pages";

interface Post {
  _id: string;
  title: string;
  slug: { current: string };
  publishedAt: string;
  excerpt: string;
  coverImage?: string;
  coverImageAlt?: string;
  body: Array<{
    _type: string;
    children?: Array<{ text: string }>;
    style?: string;
  }>;
}

export async function getStaticPaths() {
  if (!sanityClient) return [];

  let posts: Post[] = [];
  try {
    posts = await sanityClient.fetch<Post[]>(
      `*[_type == "post"] { slug }`
    );
  } catch {
    return [];
  }

  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;

if (!sanityClient) {
  return Astro.redirect("/blog");
}

const post = await sanityClient.fetch<Post>(
  `*[_type == "post" && slug.current == $slug][0] {
    _id,
    title,
    slug,
    publishedAt,
    excerpt,
    coverImage,
    coverImageAlt,
    body
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect("/blog");
}

function renderBody(body: Post["body"]): string {
  if (!body) return "";
  return body
    .map((block) => {
      if (block._type !== "block" || !block.children) return "";
      const text = block.children.map((c) => c.text).join("");
      switch (block.style) {
        case "h2":
          return `<h2 class="mt-12 font-display text-3xl text-heading">${text}</h2>`;
        case "h3":
          return `<h3 class="mt-8 font-display text-2xl text-heading">${text}</h3>`;
        case "blockquote":
          return `<blockquote class="mt-6 border-l-2 border-gold pl-5 italic text-body">${text}</blockquote>`;
        default:
          return `<p class="mt-5 text-base leading-relaxed text-body md:text-lg md:leading-relaxed">${text}</p>`;
      }
    })
    .join("\n");
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  url: new URL(`/blog/${post.slug.current}`, SITE_URL).href,
  image: post.coverImage ? new URL(post.coverImage, SITE_URL).href : undefined,
  publisher: {
    "@type": "Organization",
    name: "Basiq",
    url: SITE_URL,
  },
};
---

<Layout title={post.title} description={post.excerpt} jsonLd={jsonLd}>
  <!-- Hero -->
  <header class="relative pt-20 pb-8">
<div
      class="absolute left-1/2 top-0 -translate-x-1/2 h-[400px] w-[700px] rounded-full opacity-[0.06]"
      style="background: radial-gradient(ellipse, #234136 0%, transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-3xl px-6 lg:px-12">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-body transition-colors hover:text-heading"
      >
        <span>&larr;</span> All posts
      </a>

      <p class="mt-10 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        Blog
      </p>

      <h1 class="mt-4 font-display text-4xl leading-[1.1] tracking-tight text-heading sm:text-5xl">
        {post.title}
      </h1>

      {post.publishedAt && (
        <time class="mt-6 block font-mono text-xs uppercase tracking-wider text-sage">
          {new Date(post.publishedAt).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}
    </div>
  </header>

  <article class="relative">
    <div class="mx-auto max-w-3xl px-6 pb-24 lg:px-12">
      {post.coverImage && (
        <div class="relative mt-8 overflow-hidden rounded-2xl border border-line">
          <img
            src={post.coverImage}
            alt={post.coverImageAlt ?? post.title}
            class="w-full"
            loading="eager"
          />
        </div>
      )}

      <div class="mt-10" set:html={renderBody(post.body)} />

      <div class="mt-16 border-t border-line pt-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm text-forest transition-colors hover:text-forest"
        >
          <span>&larr;</span> Back to all posts
        </a>
      </div>
    </div>
  </article>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { SITE_URL } from "../../lib/site-pages";

const title = "Qindle: The Prospecting CRM Built for AEs";
const description =
  "The only prospecting CRM built for Account Executives to focus on account and prospect discovery and the human parts of pipe gen: cold calling and video.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${title} | Basiq`,
  description,
  url: `${SITE_URL}/products/qindle`,
  publisher: {
    "@type": "Organization",
    name: "Basiq",
    url: SITE_URL,
  },
  mainEntity: {
    "@type": "SoftwareApplication",
    name: "Qindle",
    description,
    applicationCategory: "BusinessApplication",
    url: `${SITE_URL}/products/qindle`,
  },
};

const features = [
  {
    icon: "🔍",
    title: "Account Discovery",
    body: "Surface the right accounts based on your ICP. No more digging through spreadsheets or stale CRM data.",
  },
  {
    icon: "👥",
    title: "Prospect Research",
    body: "Automatically enrich contacts with relevant context so you know exactly who to call and what to say.",
  },
  {
    icon: "📞",
    title: "Cold Call Workflows",
    body: "Purpose-built call lists, one-click dialing, and call tracking. Designed to keep you in flow, not clicking through tabs.",
  },
  {
    icon: "🎬",
    title: "Video Outreach",
    body: "Record and send personalized videos directly from the CRM. The human touch that cuts through inbox noise.",
  },
  {
    icon: "⚡",
    title: "AI-Powered Automation",
    body: "Everything that isn't a cold call or a video gets automated. Email sequences, data entry, follow-ups: handled.",
  },
  {
    icon: "📊",
    title: "Pipeline Focus",
    body: "See your pipeline health at a glance. Know exactly where to spend your time for maximum impact.",
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <header class="relative pt-24 pb-16">
<div class="relative mx-auto max-w-7xl px-6 lg:px-12">
      <div class="flex items-center gap-3">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
          CRM
        </p>
        <span class="rounded-full border border-line bg-stone px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-forest">
          Live
        </span>
      </div>
      <h1 class="mt-4 max-w-4xl font-display text-4xl leading-[1.08] tracking-tight text-heading sm:text-5xl md:text-6xl lg:text-7xl">
        Qindle
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-body">
        The only prospecting CRM built for Account Executives to focus on account
        and prospect discovery, plus the only human parts of pipe gen: cold calling
        and video.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="https://booking.akiflow.com/basiq-consulting"
          class="rounded-full bg-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-heading transition-all hover:bg-forest-hover"
        >
          Book a Demo
        </a>
        <a
          href="/products"
          class="rounded-full border border-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest transition-all hover:bg-stone"
        >
          All products
        </a>
      </div>
    </div>
  </header>

  <!-- Problem -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="max-w-3xl text-2xl font-medium leading-relaxed text-body md:text-3xl lg:text-4xl lg:leading-snug">
        AEs spend too much time on admin and not enough on the two things that
        actually generate pipeline: cold calls and personalized video outreach.
        Qindle fixes that.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        Built for AEs
      </p>
      <h2 class="mt-4 font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        Everything you need, nothing you don't
      </h2>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift">
              <span class="text-2xl text-forest">{f.icon}</span>
              <h3 class="mt-4 font-display text-xl text-heading">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-body">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl lg:text-5xl">
          Built by AEs, for AEs.
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-body">
          Qindle strips away the noise and lets you focus on what actually builds
          pipeline. Book a walkthrough and see it on your own accounts.
        </p>
        <a
          href="https://booking.akiflow.com/basiq-consulting"
          class="mt-10 inline-block rounded-full bg-forest px-8 py-4 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-heading transition-all hover:bg-forest-hover"
        >
          Book a Demo
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { products, statusLabel, ctaLabel } from "../../lib/products";
import { SITE_URL, BOOKING_URL } from "../../lib/site-pages";

const title = "Products: AI Systems for Sales, CS, and Ops";
const description =
  "The Basiq product suite: Topiq, Fabriq, Musal, Qindle, and LaneScout. AI systems for sales, customer success, prompt operations, prospecting, and freight.";

/**
 * CollectionPage + ItemList of SoftwareApplications. No `offers` block: per the
 * Rich Results spec that requires an aggregateRating, and we have no rating source.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Basiq Products",
  description,
  url: `${SITE_URL}/products`,
  publisher: {
    "@type": "Organization",
    name: "Basiq",
    url: SITE_URL,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: products.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareApplication",
        name: p.name,
        description: p.description,
        applicationCategory: "BusinessApplication",
        url: p.external ? p.href : `${SITE_URL}${p.href}`,
      },
    })),
  },
};

const liveCount = products.filter((p) => p.status === "live").length;
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-6 pb-16 pt-20 lg:px-12 lg:pt-28">
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">Products</p>
    <h1 class="mt-6 max-w-4xl font-display text-4xl leading-[1.08] tracking-tight text-heading sm:text-5xl lg:text-6xl">
      The Basiq product suite
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-body">
      We do not just build AI systems for clients, we ship them as products.
      {liveCount} in production, one on the way. Each one started as a problem we
      hit ourselves or watched a client bleed on, and each one runs in the real
      world before it ever gets a landing page.
    </p>
  </section>

  <!-- Product rows -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
      <div class="flex flex-col gap-6">
        {
          products.map((p) => (
            <a
              href={p.href}
              target={p.external ? "_blank" : undefined}
              rel={p.external ? "noopener noreferrer" : undefined}
              class="grid gap-6 rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift sm:p-10 md:grid-cols-[1fr_2fr]"
            >
              <div>
                <div class="flex items-center gap-3">
                  <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-sage">
                    {p.category}
                  </span>
                  <span
                    class={
                      p.status === "live"
                        ? "rounded-full border border-line bg-stone px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-forest"
                        : "rounded-full border border-control px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-muted"
                    }
                  >
                    {statusLabel(p.status)}
                  </span>
                </div>
                <h2 class="mt-4 font-display text-3xl text-heading">{p.name}</h2>
                <p class="mt-2 text-base italic text-forest">{p.tagline}</p>
              </div>
              <div class="flex flex-col justify-center">
                <p class="text-base leading-relaxed text-body">{p.description}</p>
                <span class="mt-6 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-forest">
                  {ctaLabel(p)}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="max-w-4xl font-display text-2xl leading-snug text-heading md:text-3xl lg:text-4xl">
        Every product here exists because we built it for a real problem, ran it in
        production, and found it was too useful to keep to ourselves. That is the same
        way we work with clients: build the thing, prove it works, hand over the keys.
      </p>
      <a href="/founders" class="mt-10 inline-block font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest">
        See how we work with clients &#8594;
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center lg:py-32">
      <h2 class="font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl lg:text-5xl">
        Want something like this for your business?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-body">
        The assessment is free. You will walk away with a clear picture of your
        highest-leverage AI opportunities and a working prototype to prove it.
      </p>
      <a
        href={BOOKING_URL}
        class="mt-10 inline-block rounded-full bg-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover"
      >
        Book a free assessment
      </a>
    </div>
  </section>
</Layout>

---
import ProductPage from "../../components/ProductPage.astro";

const audiences = [
  {
    title: "CSR Managers",
    lead: "Stop guessing which reps need coaching, and on what.",
    points: [
      "Objective performance data across every rep",
      "Scalable coaching, no manual call review",
      "Structured, measurable skill development programs",
      "A direct line from coaching activity to margin impact",
    ],
  },
  {
    title: "Carrier Sales Reps",
    lead: "Get better, faster, with feedback that's specific and immediate.",
    points: [
      "Instant post-call feedback on the skill that matters right now",
      "A clear, focused improvement path, not a fire hose of notes",
      "Visible progress that builds confidence on the phone",
      "Higher performance means higher earning potential",
    ],
  },
];

const comparison = [
  ["Flags keywords and talk time", "Scores negotiation behavior specifically"],
  ["Gives managers a report to act on", "Gives CSRs immediate post-call feedback"],
  ["Broad sales coaching", "Freight carrier negotiation, purpose-built"],
  ["Static dashboards", "Dynamic, skill-focused weekly programs"],
  ["Requires manual review", "Fully automated, 100% call coverage"],
];
---

<ProductPage
  slug="lanescout"
  headline="Your carrier desk is leaving money on the table."
  subtitle="Negotiation coaching for carrier desks."
  subheadline="Every day your CSRs call carriers to cover posted loads, and most of them do the same thing: come in with a number, take the pushback, split the difference. It feels like negotiating. It isn't."
  seoTitle="LaneScout: Negotiation Coaching for Freight Brokers"
  seoDescription="AI-powered negotiation coaching that turns your carrier desk into a margin engine. Built for US freight brokers. Coming soon from Basiq."
  ctaLabel="Get early access"
  problemsHeadline="The gap is skill, not effort."
  problems={[
    {
      num: "01",
      title: "Margin walks out on every load",
      description:
        "For a mid-size broker, the gap between what your CSRs pay carriers and benchmark market rates can exceed $200,000 per month. That is not revenue you missed. That is margin you already had.",
    },
    {
      num: "02",
      title: "Nobody hears the calls that matter",
      description:
        "A manager can review a handful of calls a week. The rest of the desk is invisible, so the habit that costs you the most is also the one nobody has ever named out loud.",
    },
    {
      num: "03",
      title: "Negotiation was never trained",
      description:
        "It is a craft, and most CSRs were never taught it. Without a rep for it, they default to the path of least resistance: meet in the middle and move on to the next load.",
    },
  ]}
  featuresHeadline="LaneScout doesn't replace your CSRs. It makes them better, one skill at a time."
  features={[
    {
      title: "Connects to your phone system",
      description:
        "LaneScout integrates with your existing call recording infrastructure. No new hardware, no workflow changes. Every carrier call is captured and analyzed automatically.",
    },
    {
      title: "AI analyzes every call",
      description:
        "The AI listens for negotiation behavior: how your CSRs open, how they anchor, how they respond to pushback, and whether they're caving before they need to. Every call gets scored.",
    },
    {
      title: "One skill per week",
      description:
        "Instead of overwhelming CSRs with everything they're doing wrong, LaneScout works with managers to pick a single high-impact skill to focus on. Focused improvement beats scattered feedback.",
    },
    {
      title: "Real-time nudges after every call",
      description:
        "After each call, the CSR gets a short, specific nudge on how they performed against that week's target skill. Immediate feedback creates faster learning loops.",
    },
    {
      title: "Scoring and manager visibility",
      description:
        "Managers get an overall negotiation score per rep, trend data over time, and team-wide visibility into where the coaching is working, and where it isn't.",
    },
    {
      title: "Knowledge that stays in the building",
      description:
        "When a CSR leaves, their negotiation instincts leave with them. LaneScout turns that instinct into a documented, repeatable system, so new reps ramp faster.",
    },
  ]}
  stats={[
    { value: "$10,000", label: "Per day from a 1% negotiation gain" },
    { value: "$3.6M", label: "Per year at 500 loads per day" },
    { value: "100%", label: "Call coverage, fully automated" },
    { value: "1", label: "Skill in focus per week" },
  ]}
  ctaHeadline="Every call is a chance to protect your margin, or give it away."
  ctaDescription="LaneScout makes sure your CSRs know the difference. We're onboarding design partners now."
>
  <!-- Who benefits -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        <span class="mr-2">&#9679;</span>Who benefits
      </p>
      <h2 class="mt-4 font-display text-4xl font-normal leading-tight tracking-[-0.02em] text-heading md:text-5xl">
        Built for the desk, not the boardroom
      </h2>

      <div class="mt-16 grid gap-8 md:grid-cols-2">
        {
          audiences.map((a) => (
            <div class="rounded-2xl border border-line bg-paper p-8 shadow-soft">
              <h3 class="font-display text-2xl text-heading">{a.title}</h3>
              <p class="mt-2 text-base italic text-forest">{a.lead}</p>
              <ul class="mt-6 space-y-3">
                {a.points.map((point) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-body">
                    <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-gold" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest">
        <span class="mr-2">&#9679;</span>What makes it different
      </p>
      <h2 class="mt-4 font-display text-4xl font-normal leading-tight tracking-[-0.02em] text-heading md:text-5xl">
        Not another call analytics tool
      </h2>

      <div class="mt-16 overflow-x-auto">
        <table class="w-full min-w-[36rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-control">
              <th class="pb-4 pr-6 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">
                Generic call analytics
              </th>
              <th class="pb-4 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-forest">
                LaneScout
              </th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map(([generic, lanescout]) => (
                <tr class="border-b border-line">
                  <td class="py-5 pr-6 text-sm leading-relaxed text-muted">{generic}</td>
                  <td class="py-5 text-sm leading-relaxed text-charcoal">{lanescout}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</ProductPage>

---
import Layout from "../layouts/Layout.astro";
import { products, statusLabel, ctaLabel, PRODUCTS_HREF } from "../lib/products";
import { personas } from "../lib/personas";
import { SITE_URL, BOOKING_URL } from "../lib/site-pages";

const steps = [
  {
    num: "01",
    title: "Free assessment",
    time: "5 to 15 hours",
    description:
      "We identify where AI moves the needle in your specific business and deliver working prototypes to prove it. Not a deck. Not a recommendation.",
  },
  {
    num: "02",
    title: "Build together",
    time: "Weeks, not months",
    description:
      "We embed with your team and build production systems: engineering workflows, sales automation, process tools, operational infrastructure. Whatever your highest-leverage entry point is.",
  },
  {
    num: "03",
    title: "You own it",
    time: "Permanent handoff",
    description:
      "We document, train, and hand off the keys. Your team owns everything we build. No retainer, no dependency, no phone call six months later asking for help.",
  },
];

const testimonials = [
  {
    quote:
      "They didn't just tell us where to use AI. They built it, trained the team, and it was running in production before the contract ended. That never happens.",
    name: "James Lawler",
    title: "Director, TricoStar",
  },
  {
    quote:
      "We had three failed AI projects before Basiq. The difference was they actually shipped working software, not a roadmap with question marks.",
    name: "Helen Lin",
    title: "CEO, Discern",
  },
  {
    quote:
      "Our outbound pipeline doubled in 6 weeks. The tools they built are still running daily. Zero maintenance on our end.",
    name: "Greg LeNeveu",
    title: "CRO, Knak",
  },
  {
    quote:
      "We saw measurable impact in weeks, not months. What stood out was how quickly they turned ideas into a meaningful business outcome.",
    name: "Jonathan Barnes",
    title: "CEO, Authentic",
  },
  {
    quote:
      "They embedded with our engineering team for four weeks and left us with three production tools we use every single day.",
    name: "Ed Seymour",
    title: "CEO, Vado",
  },
];

const clients = ["Authentic", "Knak", "Discern", "Vado", "TricoStar"];

const description =
  "Basiq is an AI execution partner for companies that need working systems, not slide decks. We embed with your team, build production systems, then hand off ownership.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Basiq",
  url: SITE_URL,
  description,
  logo: `${SITE_URL}/favicon.svg`,
  sameAs: products.filter((p) => p.external).map((p) => p.href),
};

const eyebrow = "font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest";
const sectionTitle = "font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl lg:text-5xl";
const primaryBtn =
  "inline-block rounded-full bg-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover";
const secondaryBtn =
  "inline-block rounded-full border border-forest px-7 py-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest transition-all hover:bg-stone";
---

<Layout
  title="Basiq | AI Execution Partner"
  description={description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-6 pb-20 pt-24 text-center lg:px-12 lg:pt-32">
    <p class={eyebrow}>AI execution partner</p>
    <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl leading-[1.08] tracking-tight text-heading sm:text-5xl md:text-6xl lg:text-7xl">
      AI everywhere.<br />Nothing shipping.
    </h1>
    <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-body">
      Experiments that never become systems. Tools that never become workflows. Pilots that never reach production. We build the infrastructure that turns AI from a side project into how your company operates.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={BOOKING_URL} class={primaryBtn}>Book a free assessment</a>
      <a href="#work" class={secondaryBtn}>See our work</a>
    </div>
    <p class="mt-12 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
      Five products shipped &middot; Sales &middot; Customer success &middot; Prompt ops &middot; Prospecting &middot; Freight
    </p>
  </section>

  <!-- Positioning -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class="max-w-4xl font-display text-2xl leading-snug text-heading md:text-3xl lg:text-4xl">
        Most AI consultants leave you with a strategy deck and a list of recommendations. We leave you with production systems your team uses on Monday. We embed with your engineers, sales teams, and operators. We ship real things, and we hand off ownership when it works, not before.
      </p>
    </div>
  </section>

  <!-- The one full-width Deep Forest reset band on this page. -->
  <section class="on-forest bg-forest">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <div class="text-center">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">How it works</p>
        <h2 class="mt-4 font-display text-3xl leading-tight tracking-tight text-on-dark md:text-4xl lg:text-5xl">
          Three steps. No mystery.
        </h2>
      </div>
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="rounded-2xl border border-line-dark bg-forest-raised p-8">
              <span class="font-display text-4xl leading-none text-gold">{step.num}</span>
              <h3 class="mt-5 font-display text-2xl text-on-dark">{step.title}</h3>
              <p class="mt-1 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-gold">{step.time}</p>
              <p class="mt-4 text-sm leading-relaxed text-on-dark-muted">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p class={eyebrow}>Products</p>
      <h2 class={`mt-4 ${sectionTitle}`}>Five products, four already in production.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-body">
        We build tools we use ourselves. The products we have shipped are the same systems we bring to clients.
      </p>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          products.map((p) => (
            <a
              href={p.href}
              target={p.external ? "_blank" : undefined}
              rel={p.external ? "noopener noreferrer" : undefined}
              class="flex h-full flex-col rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift"
            >
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-sage">{p.category}</span>
                <span
                  class={
                    p.status === "live"
                      ? "rounded-full border border-line bg-stone px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-forest"
                      : "rounded-full border border-control px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-muted"
                  }
                >
                  {statusLabel(p.status)}
                </span>
              </div>
              <h3 class="mt-4 font-display text-2xl text-heading">{p.name}</h3>
              <p class="mt-1 text-sm italic text-forest">{p.tagline}</p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-body">{p.description}</p>
              <span class="mt-6 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-forest">
                {ctaLabel(p)}
              </span>
            </a>
          ))
        }

        <a
          href={PRODUCTS_HREF}
          class="flex h-full flex-col justify-center rounded-2xl border border-dashed border-control bg-stone p-8 transition-colors hover:bg-paper"
        >
          <h3 class="font-display text-2xl text-heading">The full suite</h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Sales, customer success, prompt ops, CRM, and freight. See how the five fit together.
          </p>
          <span class="mt-6 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-forest">
            View all products &#8594;
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Built for your role -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-7xl px-6 py-24 text-center lg:px-12 lg:py-32">
      <p class={eyebrow}>Built for your role</p>
      <h2 class={`mt-4 ${sectionTitle}`}>Where you sit changes what you need.</h2>
      <div class="mx-auto mt-14 grid max-w-3xl gap-6 sm:grid-cols-2">
        {
          personas.map((p) => (
            <a href={p.href} class="rounded-2xl border border-line bg-paper p-8 text-left shadow-soft transition-shadow hover:shadow-lift">
              <h3 class="font-display text-2xl text-heading">{p.navLabel}</h3>
              <span class="mt-4 block font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-forest">
                See the case &#8594;
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Social proof -->
  <section id="work" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-6">
        {
          clients.map((name) => (
            <span class="font-mono text-sm uppercase tracking-[0.15em] text-sage">{name}</span>
          ))
        }
      </div>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex h-full flex-col rounded-2xl border border-line bg-paper p-8 shadow-soft">
              <blockquote class="flex-1 text-base leading-relaxed text-body">"{t.quote}"</blockquote>
              <figcaption class="mt-6 border-t border-line pt-5">
                <span class="block font-display text-lg text-heading">{t.name}</span>
                <span class="mt-0.5 block font-mono text-[10px] uppercase tracking-[0.15em] text-muted">{t.title}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center lg:py-32">
      <h2 class={sectionTitle}>
        Not sure where AI moves the needle? We will show you in a week.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-body">
        The assessment is free. You will walk away with a clear picture of your highest-leverage AI opportunities and a working prototype to prove it.
      </p>
      <a href={BOOKING_URL} class={`mt-10 ${primaryBtn}`}>Book your free assessment</a>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { SITE_URL, BOOKING_URL } from "../lib/site-pages";

const pageTitle = "8 Best AI Sales Assistant Tools for 2026: Complete Buyer's Guide";
const pageDescription =
  "Compare the 8 best AI sales assistant tools for 2026 across opportunity management, data enrichment, cold calling, CRM, and sales forecasting. Real features, pricing, and use cases.";
const canonicalUrl = `${SITE_URL}/best-ai-sales-assistant-software-2026/`;

const CLD = "https://res.cloudinary.com/drelly3f1/image/upload";
const FOLDER = "topiq/best-ai-sales-assistants-2026";
const img = (slug: string, w = 1600) => `${CLD}/w_${w},q_auto,f_auto/${FOLDER}/${slug}.png`;

interface Feature {
  label: string;
  text: string;
}

interface Product {
  n: number;
  id: string;
  name: string;
  role: string;
  featured?: boolean;
  image: { slug: string; alt: string; w: number; h: number };
  overview: string[];
  howHeading: string;
  how: string[];
  features: Feature[];
  /** Extra sections the featured entry carries that the others do not. */
  whyChoose?: { heading: string; items: Feature[] };
  whoBenefits?: { heading: string; paragraphs: string[] };
  pros?: string[];
  cons?: string[];
  bestFor: string;
  pricing: string;
  cta?: { label: string; href: string };
}


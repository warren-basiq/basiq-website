const intro = [
  "In today's hyper-competitive B2B sales landscape, artificial intelligence sales assistants have evolved from nice-to-have tools to essential components of modern sales stacks. But here's what most sales teams don't realize: AI sales assistants aren't just about automating repetitive tasks anymore. They're about intelligently optimizing specific parts of your sales workflow with specialized capabilities.",
  "Unlike traditional sales automation tools that simply execute predefined triggers, AI sales assistants act as specialized team members who never sleep, continuously learn from your data, and can handle everything from enriching prospect information to predicting which deals will close.",
  "The shift we're seeing in 2026 is remarkable: instead of investing in monolithic, one-size-fits-all platforms, leading sales teams are assembling collections of AI-powered specialists. Each assistant excels at a particular sales function, whether that's orchestrating complex data workflows, coaching reps through cold calls, or forecasting revenue with unprecedented accuracy. This specialized approach means you can optimize each stage of your sales process with best-in-class AI capabilities, rather than settling for generic automation.",
  "This comprehensive guide explores the best AI sales assistant software for each critical sales function, helping you build a tech stack where artificial intelligence amplifies your team's strengths rather than replacing them. From opportunity management to sales forecasting, we'll show you exactly how these AI assistants work and which teams they serve best.",
];

const summary = [
  "The era of AI sales assistants has arrived, and the winners won't be those with the most tools, but those who thoughtfully orchestrate specialized capabilities across their sales workflow. As we've seen, each assistant excels at solving specific challenges: from Clay's unmatched data orchestration to Trellus's real-time coaching, from Attio's intelligent CRM capabilities to Discern's precision forecasting.",
  "The key to success lies in understanding that these AI assistants work best together in a modern sales stack. Start with Topiq as your central assistant for managing the entire opportunity lifecycle, then layer in specialized tools based on your team's specific needs. Need better data? Add Clay. Struggling with cold calling? Deploy Trellus. Forecasting challenges? Bring in Discern.",
  "When selecting AI sales assistants, consider three critical criteria: First, does the AI actually learn and improve from your data, or is it just automation in disguise? Second, can it integrate seamlessly with your existing tech stack? Third, does it solve a specific, measurable problem in your sales process?",
  "Looking ahead, the future of AI sales assistance will be defined by even deeper specialization and better orchestration between tools. We're moving toward sales stacks where AI agents communicate with each other, sharing insights and triggering workflows across platforms. The companies that embrace this AI-powered, specialized approach today will have a significant competitive advantage as these technologies mature.",
  "The bottom line? AI is no longer optional for teams serious about scaling efficiently. Whether you're a startup looking to punch above your weight or an enterprise optimizing for growth, there's software designed specifically for your challenges. The question isn't whether to adopt AI sales assistants. It's which combination will transform your sales process first.",
  "Start with Topiq to centralize your AI-powered opportunity management, then build out your specialized AI sales stack from there. Your future sales success depends not on working harder, but on working smarter with the right AI assistants by your side.",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  publisher: {
    "@type": "Organization",
    name: "Basiq",
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/favicon.svg` },
  },
  mainEntity: {
    "@type": "ItemList",
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: products.length,
    itemListElement: products.map((p) => ({
      "@type": "ListItem",
      position: p.n,
      name: `${p.name}: ${p.role}`,
      url: `${canonicalUrl}#${p.id}`,
    })),
  },
};

const eyebrow = "font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest";
const subhead = "font-display text-lg text-heading";
const prose = "text-base leading-relaxed text-body";
const card = "rounded-2xl border border-line bg-paper p-6 shadow-soft";
const cardLabel = "font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-muted";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} jsonLd={jsonLd}>
  <header class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 pb-16 pt-20 lg:pb-20 lg:pt-28">
      <p class="mb-6 inline-block rounded-full border border-line bg-stone px-4 py-1.5 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-forest">
        2026 Buyer's Guide
      </p>
      <h1 class="font-display text-4xl leading-[1.1] text-heading md:text-5xl lg:text-6xl">
        The 8 Best AI Assistants <span class="text-muted">For Every Stage of Your Sales Workflow</span>
      </h1>
      <div class="mt-10">
        <img
          src={img("hero-ai-sales-assistants", 1600)}
          alt="AI Sales Assistants: Specialized Tools for Your Team"
          width="1600"
          height="679"
          loading="eager"
          class="w-full rounded-2xl border border-line"
        />
      </div>
      <div class="mt-10 max-w-3xl space-y-5 text-base leading-relaxed text-body md:text-lg">
        {intro.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </header>

  <section class="border-b border-line bg-stone">
    <div class="mx-auto max-w-5xl px-6 py-16 lg:py-20">
      <p class={eyebrow}>In this guide</p>
      <h2 class="mt-3 font-display text-2xl text-heading md:text-3xl">Top 8 Sales AI Assistants</h2>
      <ol class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          products.map((p) => (
            <li>
              <a
                href={`#${p.id}`}
                class="flex items-start gap-3 rounded-2xl border border-line bg-paper px-4 py-3 shadow-soft transition-shadow hover:shadow-lift"
              >
                <span class="pt-0.5 font-mono text-xs font-semibold text-gold">
                  {String(p.n).padStart(2, "0")}
                </span>
                <span class="text-sm text-heading">
                  <span class="font-semibold">{p.name}</span>
                  <span class="text-muted">: {p.role}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    products.map((p) => (
      <section id={p.id} class="scroll-mt-24 border-b border-line">
        <div class="mx-auto max-w-4xl px-6 py-20 lg:py-24">
          <p class={eyebrow}>
            {String(p.n).padStart(2, "0")}
            {p.featured ? " Featured" : ""}
          </p>
          <h2 class="mt-3 font-display text-3xl text-heading md:text-4xl">
            {p.name}: {p.role}
          </h2>

          <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-stone">
            <img
              src={img(p.image.slug, p.image.w)}
              alt={p.image.alt}
              width={p.image.w}
              height={p.image.h}
              loading="lazy"
              class="w-full"
            />
          </div>

          <h3 class={`mt-10 ${subhead}`}>Overview</h3>
          <div class={`mt-3 space-y-4 ${prose}`}>{p.overview.map((t) => <p>{t}</p>)}</div>

          <h3 class={`mt-10 ${subhead}`}>{p.howHeading}</h3>
          <div class={`mt-3 space-y-4 ${prose}`}>{p.how.map((t) => <p>{t}</p>)}</div>

          <h3 class={`mt-10 ${subhead}`}>Key Features</h3>
          <ul class={`mt-4 space-y-3 ${prose}`}>
            {p.features.map((f) => (
              <li>
                <span class="font-semibold text-heading">{f.label}:</span> {f.text}
              </li>
            ))}
          </ul>

          {p.whyChoose && (
            <>
              <h3 class={`mt-10 ${subhead}`}>{p.whyChoose.heading}</h3>
              <ul class={`mt-4 space-y-3 ${prose}`}>
                {p.whyChoose.items.map((f) => (
                  <li>
                    <span class="font-semibold text-heading">{f.label}:</span> {f.text}
                  </li>
                ))}
              </ul>
            </>
          )}

          {p.whoBenefits && (
            <>
              <h3 class={`mt-10 ${subhead}`}>{p.whoBenefits.heading}</h3>
              <div class={`mt-3 space-y-4 ${prose}`}>
                {p.whoBenefits.paragraphs.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </>
          )}

          {p.pros && p.cons && (
            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <div class={card}>
                <h4 class={cardLabel}>Pros</h4>
                <ul class="mt-3 space-y-2 text-sm leading-relaxed text-body">
                  {p.pros.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
              <div class={card}>
                <h4 class={cardLabel}>Cons</h4>
                <ul class="mt-3 space-y-2 text-sm leading-relaxed text-body">
                  {p.cons.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          )}

          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            <div class={card}>
              <h4 class={cardLabel}>Best For</h4>
              <p class="mt-3 text-base leading-relaxed text-body">{p.bestFor}</p>
            </div>
            <div class={card}>
              <h4 class={cardLabel}>Pricing</h4>
              <p class="mt-3 text-base leading-relaxed text-body">{p.pricing}</p>
            </div>
          </div>

          {p.cta && (
            <div class="mt-10">
              <a
                href={p.cta.href}
                class="inline-block rounded-full bg-forest px-7 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-white transition-colors hover:bg-forest-hover"
              >
                {p.cta.label}
              </a>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-b border-line bg-stone">
    <div class="mx-auto max-w-4xl px-6 py-20 lg:py-24">
      <p class={eyebrow}>Summary</p>
      <h2 class="mt-4 font-display text-3xl text-heading md:text-4xl">Building your AI sales stack</h2>
      <div class="mt-8 space-y-5 text-base leading-relaxed text-body md:text-lg">
        {summary.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="bg-forest">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center lg:py-28">
      <h2 class="font-display text-3xl text-on-dark md:text-4xl lg:text-5xl">
        Take Your Sales Process to the Next Level
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-on-dark-muted">
        Set the tone for your prospects and outclass your competition so they understand that your
        company is going to provide world-class service throughout their journey with you.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={BOOKING_URL}
          class="rounded-full bg-paper px-8 py-4 font-mono text-xs font-medium uppercase tracking-[0.12em] text-forest transition-colors hover:bg-stone"
        >
          Book a Call
        </a>
        <a
          href="/products"
          class="rounded-full border border-line-dark px-8 py-4 font-mono text-xs font-medium uppercase tracking-[0.12em] text-on-dark transition-colors hover:bg-forest-raised"
        >
          See Our Products
        </a>
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/founders"
          class="rounded-full border border-line-dark px-4 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-on-dark-muted transition-colors hover:text-on-dark"
        >
          Founders and CEOs
        </a>
        <a
          href="/revenue-leaders"
          class="rounded-full border border-line-dark px-4 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-on-dark-muted transition-colors hover:text-on-dark"
        >
          CROs and VPs of Sales
        </a>
        <a
          href="/podcast"
          class="rounded-full border border-line-dark px-4 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-on-dark-muted transition-colors hover:text-on-dark"
        >
          Selling AI Podcast
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";

const title = "How to Build a Website with Claude Code | AI Masterclass | Basiq Consulting";
const description = "Learn how to build and deploy a professional website using Claude Code. Step-by-step AI masterclass from Basiq Consulting. No coding experience required.";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Course",
        "name": "Build a Professional Website with Claude Code",
        "description": "Learn how to build and deploy a professional website using Claude Code. Step-by-step AI masterclass from Basiq Consulting. No coding experience required.",
        "provider": {
          "@type": "Organization",
          "name": "Basiq",
          "url": "https://www.basiq.work"
        },
        "instructor": {
          "@type": "Person",
          "name": "Warren Kucker"
        },
        "educationalLevel": "Beginner",
        "isAccessibleForFree": true
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do I need to know how to code?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. This masterclass is designed for non-technical founders and operators. Claude Code writes the code for you. You just need to describe what you want in plain English."
            }
          },
          {
            "@type": "Question",
            "name": "What does this cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The masterclass recording and guide are free. Claude Code requires an Anthropic subscription (around $20/month). Vercel hosting is free for personal sites. A custom domain runs about $12/year."
            }
          },
          {
            "@type": "Question",
            "name": "What kind of website can I build?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A full marketing website with multiple pages, responsive design, contact forms, blog integration, and professional-grade performance. Not a drag-and-drop template, but a real codebase you own and control."
            }
          },
          {
            "@type": "Question",
            "name": "How long does it take?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can have a live, deployed website in a single afternoon. The masterclass walks you through the entire process from zero to live in about 90 minutes."
            }
          }
        ]
      }
    ]
  };
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <header class="relative pt-32 pb-20">
<!-- Ambient glow -->
    <div
      class="absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full opacity-[0.07]"
      style="background: radial-gradient(ellipse, #234136 0%, transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-12">
      <p
        class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        AI Masterclass
      </p>
      <h1
        class="max-w-4xl text-3xl font-bold leading-[1.1] tracking-tight text-heading sm:text-4xl md:text-5xl lg:text-6xl"
      >
        Build a Professional Website with AI.
        <br />
        <span class="text-forest">No Developers Required.</span>
      </h1>
      <p
        class="mt-8 max-w-2xl text-lg leading-relaxed text-body"
      >
        A step-by-step masterclass on using Claude Code to build, customize, and deploy
        a real website &mdash; from zero to live in an afternoon. No coding experience needed.
      </p>
      <div
        class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-stone px-4 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span>Free recording &middot; Watch anytime</span>
      </div>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href="#video"
          class="rounded-full bg-forest px-7 py-3.5 text-center font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover"
        >
          Watch the Masterclass
        </a>
        <a
          href="#download"
          class="rounded-full border border-forest px-7 py-3.5 text-center font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest transition-all hover:bg-stone"
        >
          Download the Free Guide
        </a>
      </div>
    </div>
  </header>

  <!-- What this masterclass covers: 6 modules -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        What you'll learn
      </p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        How to Install Claude Code and Build Your First Project
      </h2>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Module 1 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">01</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            How to Install Claude Code
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Get set up from scratch &mdash; terminal, Node.js, Anthropic account, and your
            first Claude Code session. Even if you've never opened a terminal before.
          </p>
        </div>

        <!-- Module 2 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">02</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Setting Up Your First Project
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Initialize a website project, understand the file structure, and learn how to
            talk to Claude Code so it builds exactly what you have in mind.
          </p>
        </div>

        <!-- Module 3 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">03</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Designing Pages with AI
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Build a homepage, service pages, about page, and contact form using
            plain-English prompts. No CSS or HTML knowledge required.
          </p>
        </div>

        <!-- Module 4 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">04</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Version Control with GitHub
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Set up a GitHub repository so every change is tracked and reversible.
            Build your own knowledge base that Claude Code learns from over time.
          </p>
        </div>

        <!-- Module 5 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">05</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Deploy with Vercel in Minutes
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Push your site live with Vercel &mdash; free hosting, automatic deploys on every
            change, and a custom domain. Your site goes from local to public in minutes.
          </p>
        </div>

        <!-- Module 6 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">06</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Maintaining and Updating Your Site
          </h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-body">
            Learn the repeatable system for making changes, adding pages, and keeping
            your site current &mdash; all through conversation with Claude Code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        Who this is for
      </p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        Built for builders, not developers
      </h2>

      <div class="mt-16 grid gap-0 md:grid-cols-4">
        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10 first:border-l-0 md:first:border-l"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Founders
            </span>
          </div>
          <p class="mt-2 font-body text-sm leading-relaxed text-body">
            Launch your company's web presence without waiting on agencies or burning
            runway on a $5K–$15K build.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Consultants
            </span>
          </div>
          <p class="mt-2 font-body text-sm leading-relaxed text-body">
            Build a credible online presence that matches the quality of your work
            &mdash; and update it yourself anytime.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Coaches
            </span>
          </div>
          <p class="mt-2 font-body text-sm leading-relaxed text-body">
            Stop paying monthly for cookie-cutter templates. Own a custom site that
            reflects your brand and converts visitors to clients.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Small Business
            </span>
          </div>
          <p class="mt-2 font-body text-sm leading-relaxed text-body">
            Get a real website you control &mdash; not a Wix page &mdash; without hiring

---
import Layout from "../../layouts/Layout.astro";

const title = "Claude Code 101 | AI Masterclass | Basiq Consulting";
const description = "Claude Code 101: a hands-on introduction for non-technical teams. Get Claude Code installed, learn the command line basics, and start building real apps and automations in plain English.";

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Course",
        "name": "Claude Code 101: A Hands-On Introduction for Non-Technical Teams",
        "description": "Get Claude Code installed, learn the command line basics, and start building real apps and automations in plain English. No coding experience required.",
        "provider": {
          "@type": "Organization",
          "name": "Basiq",
          "url": "https://www.basiq.work"
        },
        "instructor": {
          "@type": "Person",
          "name": "Joe Caprara"
        },
        "educationalLevel": "Beginner",
        "isAccessibleForFree": true
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do I need any technical experience?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. This session is built for non-technical teams. We start from zero: installing Claude Code, understanding the terminal, and working in plain English. If you can describe what you want, you can use Claude Code."
            }
          },
          {
            "@type": "Question",
            "name": "What does this cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The masterclass is free. Claude Code requires an Anthropic subscription (around $20/month). That's the only cost to get started."
            }
          },
          {
            "@type": "Question",
            "name": "What can I actually build with Claude Code?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Apps, automations, websites, internal tools, data pipelines, reports, anything you'd normally need a developer for. Claude Code writes the code. You describe what you want and approve the work."
            }
          },
          {
            "@type": "Question",
            "name": "Will I have Claude Code running by the end?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We walk through installation live. You'll leave with Claude Code on your laptop, a clear understanding of how to use it, and ideas for what to build first."
            }
          }
        ]
      }
    ]
  };
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <header class="relative pt-32 pb-20">
<!-- Ambient glow -->
    <div
      class="absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full opacity-[0.07]"
      style="background: radial-gradient(ellipse, #234136 0%, transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-12">
      <p
        class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        AI Masterclass
      </p>
      <h1
        class="max-w-4xl font-display text-4xl leading-[1.08] tracking-tight text-heading sm:text-5xl md:text-6xl"
      >
        Claude Code 101.
        <br />
        <span class="text-forest">The Fastest Path From Idea to Working App.</span>
      </h1>
      <p
        class="mt-8 max-w-2xl text-lg leading-relaxed text-body"
      >
        A hands-on introduction for non-technical teams. We'll get Claude Code installed on your machine, demystify the command line, and walk through what it actually feels like to build real apps and automations in plain English.
      </p>
      <div
        class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-stone px-4 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Wednesday, June 10 &middot; 9:00 AM PT &middot; Live Online</span>
      </div>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href="https://riverside.com/webinar/registration/eyJldmVudElkIjoiNmEwMzk1YzQ3NWQ0Nzg0ZTdlODcwMmY4Iiwic2x1ZyI6IndhcnJlbi1rdWNrZXJzLXN0dWRpbyJ9"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-forest px-7 py-3.5 text-center font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-white transition-all hover:bg-forest-hover"
        >
          Register for the Masterclass
        </a>
      </div>
    </div>
  </header>

  <!-- What this masterclass covers: 5 modules -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        What you'll learn
      </p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        From Installation to Your First Build
      </h2>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Module 1 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">01</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Installing Claude Code
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            We start from zero. Get Claude Code installed on your machine and demystify the command line. It's just a text box that talks to your computer.
          </p>
        </div>

        <!-- Module 2 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">02</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Working with Claude
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            What it actually feels like to build with AI. Ask for things in plain English, review the changes Claude proposes, and approve the work before anything happens. You stay in control.
          </p>
        </div>

        <!-- Module 3 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">03</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Slash Commands
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Learn the shortcuts that make Claude Code powerful. Slash commands let you control your session, manage context, and work faster without memorizing anything technical.
          </p>
        </div>

        <!-- Module 4 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">04</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Modes: Plan, Default, and Auto
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Claude Code has three modes that let you dial in how much autonomy it has. Plan mode thinks before acting. Default mode checks with you at every step. Auto mode runs on its own. You pick what fits.
          </p>
        </div>

        <!-- Module 5 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">05</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            Skills and Agents
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            The building blocks for turning repeated tasks into reusable workflows. Instead of explaining the same thing every time, you teach Claude once and run it with a single command.
          </p>
        </div>

        <!-- Module 6 -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="font-mono text-sm font-bold text-forest">06</span>
          <h3 class="mt-3 font-display text-xl text-heading">
            What to Build First
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            We'll wrap up with concrete ideas for your first project. Not hypotheticals. Real automations and applications you can start building the same day with what you just learned.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        Who this is for
      </p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        Built for non-technical teams looking to automate and build
      </h2>

      <div class="mt-16 grid gap-0 md:grid-cols-4">
        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10 first:border-l-0 md:first:border-l"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Operations
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-body">
            Automate the manual workflows your team runs every week. Reports, data processing, internal tools. No engineering ticket required.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Sales
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-body">
            Build prospecting tools, automate CRM cleanup, and create outreach workflows. Stop waiting on someone else to build what you need.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Marketing
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-body">
            Generate content, build landing pages, and automate repetitive campaigns. Own the tools instead of depending on vendors.
          </p>
        </div>

        <div
          class="relative border-l border-line p-5 pl-6 sm:p-8 sm:pl-10"
        >
          <div
            class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-gold to-transparent md:block"
          >
          </div>
          <div class="mb-3 inline-block rounded-full border border-line bg-stone px-3 py-1">
            <span class="font-mono text-xs font-medium text-forest">
              Product
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-body">
            Prototype features, ship internal tools, and validate ideas without waiting on an engineering sprint. Move from spec to working demo in an afternoon.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You'll Walk Away With -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        The outcome
      </p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        What you'll walk away with
      </h2>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        <div
          class="rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-stone">
            <svg class="h-6 w-6 text-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h3 class="mt-5 font-display text-xl text-heading">
            Claude Code on your laptop
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Installed, configured, and working. Not a demo you watched someone else do. Your own setup, ready to use the moment the session ends.
          </p>
        </div>

        <div
          class="rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-stone">
            <svg class="h-6 w-6 text-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
            </svg>
          </div>
          <h3 class="mt-5 font-display text-xl text-heading">
            A clear mental model
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            How to direct Claude Code safely. When to use which mode. How to review changes before they happen. The confidence to start building on your own.
          </p>
        </div>

        <div
          class="rounded-2xl border border-line bg-paper p-6 shadow-soft transition-shadow hover:shadow-lift"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-stone">
            <svg class="h-6 w-6 text-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="mt-5 font-display text-xl text-heading">
            Concrete ideas for what to build first
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Not hypotheticals. Real projects matched to your role and your workflow. The kind of thing you can start the same afternoon and have working by the end of the week.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Instructor -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-10 md:grid-cols-[280px_1fr] md:items-center md:gap-12 lg:grid-cols-[320px_1fr] lg:gap-16">
          <!-- Photo -->
          <div class="relative">
            <div
              class="absolute -inset-6 rounded-3xl bg-sage/20 blur-3xl"
              aria-hidden="true"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-2xl border border-line bg-paper shadow-2xl shadow-black/40"
            >
              <img
                src="/images/joe-caprara.jpg"
                alt="Joe Caprara, founder of Basiq"
                width="640"
                height="800"
                loading="lazy"
                class="aspect-[4/5] w-full object-cover"
              />
            </div>
          </div>

          <!-- Text -->
          <div>
            <p
              class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
            >
              Your instructor
            </p>
            <h2 class="mt-4 font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
              Joe Caprara
            </h2>
            <p class="mt-6 text-base leading-relaxed text-body">
              Joe is the founder of Basiq, a San Diego consulting firm that helps
              companies move from AI-curious to AI-native across engineering, operations,
              and go-to-market. He's started three companies, had two successful exits,
              and writes regularly on AI adoption and how the role of the CTO is changing
              in the AI era.
            </p>
            <p class="mt-4 text-base leading-relaxed text-body">
              This masterclass is the same hands-on approach Joe uses with his consulting
              clients. No theory and no slides about the future of work. Get Claude Code
              installed, build something real, and walk away with a clear plan for what
              to automate next.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <span class="rounded-full border border-line px-4 py-1.5 text-xs text-body">Founder, Basiq</span>
              <span class="rounded-full border border-line px-4 py-1.5 text-xs text-body">3 companies &middot; 2 exits</span>
              <span class="rounded-full border border-line px-4 py-1.5 text-xs text-body">Claude Code</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        FAQ
      </p>
      <h2 class="mt-4 font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        Common questions
      </h2>

      <div class="mt-16 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-line bg-paper p-6 shadow-soft">
          <h3 class="font-display text-xl text-heading">
            Do I need any technical experience?
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            No. This session is built for non-technical teams. We start from zero.
            Installing Claude Code, understanding the terminal, and working in plain
            English. If you can describe what you want, you can use Claude Code.
          </p>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-6 shadow-soft">
          <h3 class="font-display text-xl text-heading">
            What does this cost?
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            The masterclass is free. Claude Code requires an Anthropic subscription
            (around $20/month). That's the only cost to get started.
          </p>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-6 shadow-soft">
          <h3 class="font-display text-xl text-heading">
            What can I actually build with Claude Code?
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Apps, automations, websites, internal tools, data pipelines, reports.
            Anything you'd normally need a developer for. Claude Code writes the code.
            You describe what you want and approve the work.
          </p>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-6 shadow-soft">
          <h3 class="font-display text-xl text-heading">
            Will I have Claude Code running by the end?
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-body">
            Yes. We walk through installation live. You'll leave with Claude Code on
            your laptop, a clear understanding of how to use it, and ideas for what
            to build first.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Webinar Registration Form -->
  <section id="register" class="border-t border-line">
    <div class="mx-auto max-w-3xl px-6 py-24 lg:px-12 lg:py-32">
      <p
        class="text-center font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest"
      >
        Register
      </p>
      <h2 class="mt-4 text-center font-display text-3xl leading-tight tracking-tight text-heading md:text-4xl">
        Save your seat
      </h2>
      <p class="mt-4 text-center text-base text-heading/70">
        Reserve your spot for the live masterclass.
      </p>
      <div class="mt-6 flex justify-center">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-line bg-stone px-4 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-forest"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Wednesday, June 10 &middot; 9:00 AM PT &middot; Live Online</span>
        </div>
      </div>
      <div class="mt-10 text-center">
        <a
          href="https://riverside.com/webinar/registration/eyJldmVudElkIjoiNmEwMzk1YzQ3NWQ0Nzg0ZTdlODcwMmY4Iiwic2x1ZyI6IndhcnJlbi1rdWNrZXJzLXN0dWRpbyJ9"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full bg-forest px-8 py-4 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-heading transition-all hover:bg-forest-hover"
        >
          Register Now
        </a>
        <p class="mt-4 text-xs text-muted">Free &middot; Live on Riverside</p>
      </div>
    </div>
  </section>

  
</Layout>

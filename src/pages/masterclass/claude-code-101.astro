---
import "../../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Claude Code 101 — A hands-on introduction for non-technical teams. Get Claude Code installed, learn the command line basics, and start building real apps and automations in plain English."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Claude Code 101 | AI Masterclass | Basiq Consulting</title>

    <!-- Course Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Course",
        "name": "Claude Code 101 — A Hands-On Introduction for Non-Technical Teams",
        "description": "Get Claude Code installed, learn the command line basics, and start building real apps and automations in plain English. No coding experience required.",
        "provider": {
          "@type": "Organization",
          "name": "Basiq Consulting",
          "url": "https://basiqconsulting.com"
        },
        "instructor": {
          "@type": "Person",
          "name": "Warren Kucker"
        },
        "educationalLevel": "Beginner",
        "isAccessibleForFree": true
      }
    </script>

    <!-- FAQ Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do I need any technical experience?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. This session is built for non-technical teams. We start from zero — installing Claude Code, understanding the terminal, and working in plain English. If you can describe what you want, you can use Claude Code."
            }
          },
          {
            "@type": "Question",
            "name": "What does this cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The masterclass is free. Claude Code requires an Anthropic subscription (around $20/month). That's the only cost to get started."
            }
          },
          {
            "@type": "Question",
            "name": "What can I actually build with Claude Code?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Apps, automations, websites, internal tools, data pipelines, reports — anything you'd normally need a developer for. Claude Code writes the code. You describe what you want and approve the work."
            }
          },
          {
            "@type": "Question",
            "name": "Will I have Claude Code running by the end?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We walk through installation live. You'll leave with Claude Code on your laptop, a clear understanding of how to use it, and ideas for what to build first."
            }
          }
        ]
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-[#0a0a0a] text-[#e8e5e0] antialiased selection:bg-amber-400/20 selection:text-amber-200"
  >
    <!-- Grain overlay -->
    <div
      class="pointer-events-none fixed inset-0 z-50 opacity-[0.03]"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;); background-repeat: repeat; background-size: 256px 256px;"
    >
    </div>

    <!-- Nav -->
    <nav
      class="fixed top-0 z-40 w-full border-b border-white/[0.06] bg-[#0a0a0a]/80 backdrop-blur-xl"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-12"
      >
        <a href="/" aria-label="Basiq home" class="inline-flex items-start">
          <span class="text-2xl font-bold tracking-tight text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">basiq</span>
          <svg class="ml-[2px] mt-[-3px] h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 6L14 12L8 18" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M14 6L20 12L14 18" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="hidden items-center gap-8 md:flex">
          <a
            href="/#services"
            class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white"
            >Services</a
          >
          <a
            href="/#work"
            class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white"
            >Work</a
          >
          <a
            href="/#about"
            class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white"
            >About</a
          >
        </div>
        <div class="flex items-center gap-4">
          <a
            href="https://booking.akiflow.com/basiq-consulting"
            class="rounded-lg bg-amber-400 px-5 py-2.5 text-sm font-semibold text-[#0a0a0a] transition-all hover:bg-amber-300"
          >
            Book a Call
          </a>
          <button
            id="mobile-menu-btn"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.08] md:hidden"
            aria-label="Toggle menu"
          >
            <svg id="menu-icon-open" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="hidden h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-white/[0.06] bg-[#0a0a0a]/95 backdrop-blur-xl md:hidden">
        <div class="flex flex-col gap-1 px-6 py-4">
          <a href="/#services" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">Services</a>
          <a href="/#work" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">Work</a>
          <a href="/#about" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">About</a>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <header class="relative pt-32 pb-20">
      <div
        class="absolute inset-0 opacity-[0.04]"
        style="background-image: linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 80px 80px;"
      >
      </div>

      <!-- Ambient glow -->
      <div
        class="absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full opacity-[0.07]"
        style="background: radial-gradient(ellipse, #F59E0B 0%, transparent 70%);"
      >
      </div>

      <div class="relative mx-auto max-w-7xl px-6 lg:px-12">
        <p
          class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-amber-400/80"
        >
          AI Masterclass
        </p>
        <h1
          class="max-w-4xl text-3xl font-bold leading-[1.1] tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl"
        >
          Claude Code 101.
          <br />
          <span class="text-amber-400">Start Building Without Learning to Code.</span>
        </h1>
        <p
          class="mt-8 max-w-2xl font-body text-lg leading-relaxed text-[#a09d97] md:text-xl"
        >
          A hands-on introduction for non-technical teams. We'll get Claude Code installed on your machine, demystify the command line, and walk through what it actually feels like to build real apps and automations in plain English.
        </p>
        <div
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-amber-400/20 bg-amber-400/10 px-4 py-2 text-sm font-semibold text-amber-300"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Wednesday, June 3 &middot; 9:00 AM PT &middot; Live Online</span>
        </div>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href="https://riverside.com/webinar/registration/eyJldmVudElkIjoiNmEwMzk1YzQ3NWQ0Nzg0ZTdlODcwMmY4Iiwic2x1ZyI6IndhcnJlbi1rdWNrZXJzLXN0dWRpbyJ9"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-amber-400 px-7 py-3.5 text-center text-sm font-semibold text-[#0a0a0a] transition-all hover:bg-amber-300 hover:shadow-lg hover:shadow-amber-400/20"
          >
            Register for the Masterclass
          </a>
        </div>
      </div>
    </header>

    <!-- What This Masterclass Covers — 5 Modules -->
    <section class="border-t border-white/[0.06]">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
        <p
          class="text-sm font-medium uppercase tracking-[0.2em] text-amber-400/80"
        >
          What you'll learn
        </p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold text-white md:text-4xl">
          From Installation to Your First Build
        </h2>

        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Module 1 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">01</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              Installing Claude Code
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              We start from zero. Get Claude Code installed on your machine and demystify the command line. It's just a text box that talks to your computer.
            </p>
          </div>

          <!-- Module 2 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">02</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              Working with Claude
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              What it actually feels like to build with AI. Ask for things in plain English, review the changes Claude proposes, and approve the work before anything happens. You stay in control.
            </p>
          </div>

          <!-- Module 3 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">03</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              Slash Commands
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              Learn the shortcuts that make Claude Code powerful. Slash commands let you control your session, manage context, and work faster without memorizing anything technical.
            </p>
          </div>

          <!-- Module 4 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">04</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              Modes: Plan, Default, and Auto
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              Claude Code has three modes that let you dial in how much autonomy it has. Plan mode thinks before acting. Default mode checks with you at every step. Auto mode runs on its own. You pick what fits.
            </p>
          </div>

          <!-- Module 5 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">05</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              Skills and Agents
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              The building blocks for turning repeated tasks into reusable workflows. Instead of explaining the same thing every time, you teach Claude once and run it with a single command.
            </p>
          </div>

          <!-- Module 6 -->
          <div
            class="group relative overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <span class="font-mono text-sm font-bold text-amber-400/70">06</span>
            <h3 class="mt-3 text-lg font-semibold text-white">
              What to Build First
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              We'll wrap up with concrete ideas for your first project. Not hypotheticals. Real automations and applications you can start building the same day with what you just learned.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who This Is For -->
    <section class="border-t border-white/[0.06]">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
        <p
          class="text-sm font-medium uppercase tracking-[0.2em] text-amber-400/80"
        >
          Who this is for
        </p>
        <h2 class="mt-4 max-w-2xl text-3xl font-bold text-white md:text-4xl">
          Built for people who don't write code
        </h2>

        <div class="mt-16 grid gap-0 md:grid-cols-4">
          <div
            class="relative border-l border-white/[0.06] p-5 pl-6 sm:p-8 sm:pl-10 first:border-l-0 md:first:border-l"
          >
            <div
              class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-amber-400 to-amber-400/0 md:block"
            >
            </div>
            <div class="mb-3 inline-block rounded-full bg-amber-400/10 px-3 py-1">
              <span class="font-mono text-xs font-medium text-amber-400">
                Operations
              </span>
            </div>
            <p class="mt-2 font-body text-sm leading-relaxed text-[#a09d97]">
              Automate the manual workflows your team runs every week. Reports, data processing, internal tools. No engineering ticket required.
            </p>
          </div>

          <div
            class="relative border-l border-white/[0.06] p-5 pl-6 sm:p-8 sm:pl-10"
          >
            <div
              class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-amber-400 to-amber-400/0 md:block"
            >
            </div>
            <div class="mb-3 inline-block rounded-full bg-amber-400/10 px-3 py-1">
              <span class="font-mono text-xs font-medium text-amber-400">
                Sales
              </span>
            </div>
            <p class="mt-2 font-body text-sm leading-relaxed text-[#a09d97]">
              Build prospecting tools, automate CRM cleanup, and create outreach workflows. Stop waiting on someone else to build what you need.
            </p>
          </div>

          <div
            class="relative border-l border-white/[0.06] p-5 pl-6 sm:p-8 sm:pl-10"
          >
            <div
              class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-amber-400 to-amber-400/0 md:block"
            >
            </div>
            <div class="mb-3 inline-block rounded-full bg-amber-400/10 px-3 py-1">
              <span class="font-mono text-xs font-medium text-amber-400">
                Marketing
              </span>
            </div>
            <p class="mt-2 font-body text-sm leading-relaxed text-[#a09d97]">
              Generate content, build landing pages, and automate repetitive campaigns. Own the tools instead of depending on vendors.
            </p>
          </div>

          <div
            class="relative border-l border-white/[0.06] p-5 pl-6 sm:p-8 sm:pl-10"
          >
            <div
              class="absolute left-0 top-8 hidden h-16 w-px bg-gradient-to-b from-amber-400 to-amber-400/0 md:block"
            >
            </div>
            <div class="mb-3 inline-block rounded-full bg-amber-400/10 px-3 py-1">
              <span class="font-mono text-xs font-medium text-amber-400">
                Business Leaders
              </span>
            </div>
            <p class="mt-2 font-body text-sm leading-relaxed text-[#a09d97]">
              Understand what Claude Code can do so you can identify opportunities across your team. See what's possible before you hire or outsource.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What You'll Walk Away With -->
    <section class="border-t border-white/[0.06]">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
        <p
          class="text-sm font-medium uppercase tracking-[0.2em] text-amber-400/80"
        >
          The outcome
        </p>
        <h2 class="mt-4 max-w-2xl text-3xl font-bold text-white md:text-4xl">
          What you'll walk away with
        </h2>

        <div class="mt-16 grid gap-6 md:grid-cols-3">
          <div
            class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-400/10">
              <svg class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-white">
              Claude Code on your laptop
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              Installed, configured, and working. Not a demo you watched someone else do. Your own setup, ready to use the moment the session ends.
            </p>
          </div>

          <div
            class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-400/10">
              <svg class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-white">
              A clear mental model
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              How to direct Claude Code safely. When to use which mode. How to review changes before they happen. The confidence to start building on your own.
            </p>
          </div>

          <div
            class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all duration-300 hover:border-amber-400/20 hover:bg-white/[0.04]"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-400/10">
              <svg class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-white">
              Concrete ideas for what to build first
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-[#a09d97]">
              Not hypotheticals. Real projects matched to your role and your workflow. The kind of thing you can start the same afternoon and have working by the end of the week.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- About the Instructor -->
    <section class="border-t border-white/[0.06]">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
        <div class="mx-auto max-w-3xl">
          <p
            class="text-sm font-medium uppercase tracking-[0.2em] text-amber-400/80"
          >
            Your instructor
          </p>
          <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">
            Warren Kucker
          </h2>
          <p class="mt-6 font-body text-base leading-relaxed text-[#a09d97]">
            Warren is the founder of Basiq Consulting, where he helps companies go
            from AI-curious to AI-native across engineering, operations, and go-to-market.
            He's also the host of the Selling AI Podcast, where he breaks down how
            businesses are actually using AI to grow. Not just talking about it.
          </p>
          <p class="mt-4 font-body text-base leading-relaxed text-[#a09d97]">
            This masterclass comes from teaching dozens of non-technical teams how to
            use Claude Code to build real tools and automations. No fluff. No theory. Just the
            practical stuff that gets you from zero to building.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">

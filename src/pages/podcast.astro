---
import Layout from "../layouts/Layout.astro";
import {
  getShow,
  getEpisodes,
  episodeMeta,
  PODCAST_CANONICAL_ORIGIN,
  PODCAST_CANONICAL_PATH,
} from "../lib/podcast";

const show = await getShow();
const episodes = await getEpisodes();

// Defaults keep the page complete before the show document exists in Sanity.
const title = show?.title || "Selling AI";
const tagline = show?.tagline || "The podcast for revenue teams selling and using AI.";
const description =
  show?.description ||
  "Weekly conversations with founders, CROs, and AEs on the strategies, tools, and stories behind selling AI products and using AI to sell smarter.";
const applePodcastsUrl =
  show?.applePodcastsUrl || "https://podcasts.apple.com/us/podcast/selling-ai/id1866408000";
const spotifyUrl = show?.spotifyUrl || "https://open.spotify.com/show/4YKfcQzrtyfuxUahc5AHX2";
const youtubeUrl =
  show?.youtubeUrl ||
  "https://www.youtube.com/playlist?list=PLwp557Pg7NhfMZ_9KwG3FajKI3wvB4ny0";
const hostName = show?.hostName || "Warren Kucker";
const hostBio =
  show?.hostBio ||
  "A revenue leader and entrepreneur who founded Basiq, focusing on conversational AI for sales teams. Previously VP of Sales and CRO at Series B companies, scaling revenue past $2M in quarterly bookings. His exits include Shelly.ai and Boxton. He started his career at Apple managing a $100M shipping efficiency program.";

const seoTitle = `${title} Podcast | Basiq`;
const seoDescription = `${tagline} ${description}`;

const platforms = [
  { label: "Apple Podcasts", href: applePodcastsUrl },
  { label: "Spotify", href: spotifyUrl },
  { label: "YouTube", href: youtubeUrl },
].filter((p) => p.href);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: title,
  description,
  url: `${PODCAST_CANONICAL_ORIGIN}${PODCAST_CANONICAL_PATH}`,
  author: { "@type": "Person", name: hostName },
};

const eyebrow = "font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-forest";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={`${PODCAST_CANONICAL_ORIGIN}${PODCAST_CANONICAL_PATH}`}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-6 pb-16 pt-20 lg:pt-28">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <p class={eyebrow}>Podcast</p>
        <h1 class="mt-6 font-display text-4xl leading-[1.08] tracking-tight text-heading sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        <p class="mt-4 text-xl italic text-forest">{tagline}</p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-body">{description}</p>
      </div>

      {
        show?.artworkUrl ? (
          <img
            src={show.artworkUrl}
            alt={`${title} cover art`}
            class="mx-auto h-48 w-48 rounded-2xl border border-line object-cover shadow-lift md:mx-0 md:h-56 md:w-56"
          />
        ) : (
          <div class="mx-auto flex h-48 w-48 flex-col items-center justify-center gap-2 rounded-2xl border border-line-dark bg-forest shadow-lift md:mx-0 md:h-56 md:w-56">
            <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.22em] text-gold">Podcast</span>
            <span class="text-center font-display text-3xl leading-tight text-on-dark">{title}</span>
          </div>
        )
      }
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        platforms.map((p) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-control px-5 py-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-forest transition-colors hover:bg-stone"
          >
            {p.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-stone">
    <div class="mx-auto max-w-5xl px-6 py-20">
      {
        episodes.length > 0 ? (
          <div class="flex flex-col gap-6">
            {episodes.map((ep) => (
              <a
                href={`/episode/${ep.slug}`}
                class="block rounded-2xl border border-line bg-paper p-8 shadow-soft transition-shadow hover:shadow-lift"
              >
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-forest px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.12em] text-on-dark">
                    Ep. {ep.episodeNumber}
                  </span>
                  {episodeMeta(ep).map((meta) => (
                    <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">{meta}</span>
                  ))}
                </div>
                <h2 class="mt-4 font-display text-2xl text-heading">{ep.title}</h2>
                {ep.guestName && (
                  <p class="mt-2 text-sm italic text-forest">
                    {`with ${ep.guestName}${ep.guestTitle ? `, ${ep.guestTitle}` : ""}`}
                  </p>
                )}
                {ep.summary && <p class="mt-3 text-sm leading-relaxed text-body">{ep.summary}</p>}
                {ep.takeaways?.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {ep.takeaways.slice(0, 3).map((t) => (
                      <span class="rounded-md border border-line px-2.5 py-1 text-xs text-muted">{t}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-control bg-paper p-12 text-center">
            <p class="text-body">
              No episodes here yet. Add them in Sanity Studio, or listen on
              {" "}
              <a href={applePodcastsUrl} class="text-forest underline underline-offset-4">Apple Podcasts</a>.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class={eyebrow}>Your host</p>
      <div class="mt-8 grid gap-8 rounded-2xl border border-line bg-paper p-8 shadow-soft sm:grid-cols-[auto_1fr] sm:items-start">
        {
          show?.hostImageUrl && (
            <img
              src={show.hostImageUrl}
              alt={hostName}
              class="h-24 w-24 rounded-full border border-line object-cover"
            />
          )
        }
        <div>
          <h2 class="font-display text-2xl text-heading">{hostName}</h2>
          <p class="mt-3 leading-relaxed text-body">{hostBio}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

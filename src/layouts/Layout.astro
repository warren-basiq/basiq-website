---
import "../styles/global.css";
import { products, statusLabel, PRODUCTS_HREF } from "../lib/products";
import { SITE_URL } from "../lib/site-pages";

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. Defaults to the www host + current path. */
  canonical?: string;
  ogImage?: string;
  /** JSON-LD object injected as application/ld+json. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Basiq — AI execution partner. Working systems, not slide decks.",
  canonical,
  ogImage = `${SITE_URL}/og-default.png`,
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const fullTitle = `${title} | Basiq`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Basiq" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body
    class="min-h-screen bg-[#0a0a0a] text-[#e8e5e0] antialiased selection:bg-amber-400/20 selection:text-amber-200"
  >
    <!-- Grain overlay -->
    <div
      class="pointer-events-none fixed inset-0 z-50 opacity-[0.03]"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;); background-repeat: repeat; background-size: 256px 256px;"
    >
    </div>

    <!-- Nav -->
    <nav
      class="fixed top-0 z-40 w-full border-b border-white/[0.06] bg-[#0a0a0a]/80 backdrop-blur-xl"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-12"
      >
        <a href="/" aria-label="Basiq home" class="inline-flex items-start">
          <span class="text-2xl font-bold tracking-tight text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">basiq</span>
          <svg class="ml-[2px] mt-[-3px] h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 6L14 12L8 18" transform="rotate(-45 12 12)" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M14 6L20 12L14 18" transform="rotate(-45 12 12)" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="hidden items-center gap-8 md:flex">
          <a href="/#services" class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white">Services</a>
          <a href="/#work" class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white">Work</a>

          <div class="group relative">
            <a href={PRODUCTS_HREF} class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white">Products</a>
            <div class="invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100">
              <div class="rounded-lg border border-white/[0.08] bg-[#141414] p-2 shadow-2xl">
                {
                  products.map((p) => (
                    <a
                      href={p.href}
                      target={p.external ? "_blank" : undefined}
                      rel={p.external ? "noopener noreferrer" : undefined}
                      class="block rounded-md px-3 py-2.5 transition-colors hover:bg-white/[0.04]"
                    >
                      <span class="flex items-center gap-2">
                        <span class="text-sm font-medium text-[#e8e5e0]">{p.name}</span>
                        {p.external && (
                          <span class="text-xs text-amber-400/70">{p.host} ↗</span>
                        )}
                        {p.status === "coming-soon" && (
                          <span class="rounded-full bg-white/[0.06] px-2 py-0.5 text-[10px] font-medium text-[#a09d97]">
                            Soon
                          </span>
                        )}
                      </span>
                      <span class="mt-0.5 block text-xs text-[#706d67]">{p.tagline}</span>
                    </a>
                  ))
                }
                <a
                  href={PRODUCTS_HREF}
                  class="mt-1 block rounded-md border-t border-white/[0.06] px-3 pb-2 pt-3 text-sm text-amber-400/70 transition-colors hover:text-amber-400"
                >
                  All products →
                </a>
              </div>
            </div>
          </div>

          <a href="/blog" class="text-sm tracking-wide text-[#a09d97] transition-colors hover:text-white">Blog</a>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="https://booking.akiflow.com/basiq-consulting"
            class="rounded-lg bg-amber-400 px-5 py-2.5 text-sm font-semibold text-[#0a0a0a] transition-all hover:bg-amber-300"
          >
            Book a Call
          </a>
          <button
            id="mobile-menu-btn"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.08] md:hidden"
            aria-label="Toggle menu"
          >
            <svg id="menu-icon-open" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="hidden h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-white/[0.06] bg-[#0a0a0a]/95 backdrop-blur-xl md:hidden">
        <div class="flex flex-col gap-1 px-6 py-4">
          <a href="/#services" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">Services</a>
          <a href="/#work" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">Work</a>
          <a href="/blog" class="rounded-lg px-4 py-3 text-sm tracking-wide text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white">Blog</a>

          <div class="my-2 border-t border-white/[0.06]"></div>
          <a href={PRODUCTS_HREF} class="px-4 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[#a09d97]/60">Products</a>
          {
            products.map((p) => (
              <a
                href={p.href}
                target={p.external ? "_blank" : undefined}
                rel={p.external ? "noopener noreferrer" : undefined}
                class="flex items-center gap-2 rounded-lg px-4 py-3 text-sm text-[#a09d97] transition-colors hover:bg-white/[0.04] hover:text-white"
              >
                {p.name}
                {p.external && <span class="text-xs text-amber-400/70">{p.host} ↗</span>}
                {p.status === "coming-soon" && (
                  <span class="rounded-full bg-white/[0.06] px-2 py-0.5 text-[10px] font-medium text-[#a09d97]">
                    Soon
                  </span>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-white/[0.06]">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-12">
        <div class="grid gap-12 md:grid-cols-4">
          <div class="md:col-span-1">
            <a href="/" aria-label="Basiq home" class="inline-flex items-start">
              <span class="text-xl font-bold tracking-tight text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">basiq</span>
              <svg class="ml-[2px] mt-[-2px] h-[15px] w-[15px]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 6L14 12L8 18" transform="rotate(-45 12 12)" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M14 6L20 12L14 18" transform="rotate(-45 12 12)" stroke="#4ADE80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <p class="mt-3 text-sm text-[#a09d97]">
              AI execution partner.<br />Working systems, not slide decks.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.15em] text-[#a09d97]">Company</h4>
            <ul class="mt-4 space-y-3">
              <li><a href="/#services" class="text-sm text-[#706d67] transition-colors hover:text-white">Services</a></li>
              <li><a href="/#work" class="text-sm text-[#706d67] transition-colors hover:text-white">Work</a></li>
              <li><a href="/blog" class="text-sm text-[#706d67] transition-colors hover:text-white">Blog</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.15em] text-[#a09d97]">Products</h4>
            <ul class="mt-4 space-y-3">
              {
                products.map((p) => (
                  <li>
                    <a
                      href={p.href}
                      target={p.external ? "_blank" : undefined}
                      rel={p.external ? "noopener noreferrer" : undefined}
                      class="text-sm text-[#706d67] transition-colors hover:text-white"
                    >
                      {p.name}
                      {p.status === "coming-soon" && (
                        <span class="ml-2 text-xs text-[#706d67]/70">{statusLabel(p.status)}</span>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.15em] text-[#a09d97]">Connect</h4>
            <ul class="mt-4 space-y-3">
              <li><a href="https://booking.akiflow.com/basiq-consulting" class="text-sm text-[#706d67] transition-colors hover:text-white">Book a Call</a></li>
              <li><span class="text-sm text-[#706d67]">basiq.work</span></li>
            </ul>
          </div>
        </div>
        <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-8 text-xs text-[#706d67] md:flex-row">
          <p>&copy; {year} Basiq. All rights reserved.</p>
          <div class="flex gap-6">
            <a href="#" class="transition-colors hover:text-white">Privacy</a>
            <a href="#" class="transition-colors hover:text-white">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
